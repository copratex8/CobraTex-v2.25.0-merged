# ───────────── CobraTex ERP — إعدادات الباك إند ─────────────
# انسخ هذا الملف إلى .env محليًا. على الاستضافة السحابية تُضبط هذه القيم كمتغيرات بيئة في لوحة الخدمة.

# رابط PostgreSQL.
#  محلي:    postgresql://postgres:devpassword@localhost:5432/cobratex_dev
#  Supabase: انسخ "Connection string" من Project Settings → Database (يُفضَّل Session pooler، المنفذ 5432،
#            أو Transaction pooler المنفذ 6543 عند التشغيل على Vercel Serverless). اجعل كلمة المرور مُرمَّزة URL.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/cobratex_dev"

# SSL: auto (افتراضي: يُفعَّل تلقائيًا لأي مضيف غير محلي) | true | false
DATABASE_SSL=auto
# اختياري: شهادة CA لـ Supabase (PEM) لتحقق صارم من هوية الخادم. بدونها: اتصال مشفَّر بلا تحقق من الهوية.
# DATABASE_SSL_CA=

# أقصى اتصالات (افتراضي 10). على Vercel Serverless استخدم 1 أو 2.
# DB_POOL_MAX=10

# أسرار JWT — ولِّد قيمًا عشوائية طويلة (32+ حرفًا) لكل بيئة: openssl rand -hex 32  (في الإنتاج يرفض الخادم الإقلاع بأقل من 32 حرفًا)
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# خلف بروكسي (Vercel/Render/Nginx): TRUST_PROXY=1 ليُحسب حدّ المحاولات على IP العميل الحقيقي (الافتراضي 1 في الإنتاج).
# TRUST_PROXY=1

PORT=4000
NODE_ENV=development

# إلزامي في أي بيئة منشورة: يحمي POST /api/bootstrap من إنشاء مستأجرين بلا حد.
BOOTSTRAP_SECRET=""

# اختياري — إشعارات Web Push (node -e "console.log(require('web-push').generateVAPIDKeys())")
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# اختياري — ملف JSON ثابت لإدارة التحديثات/الإعلانات/الترخيص عن بُعد (راجع docs/CLOUD-AND-UPDATES.md)
# UPDATE_FEED_URL=https://raw.githubusercontent.com/<you>/<repo>/main/update-feed.json

# ───── لوحة المطور الخارجية (التحكم عن بُعد) ─────
# كلمة مرور المطوّر لدخول لوحة المطور (8+ أحرف، يُفضَّل 24+ عشوائية: openssl rand -base64 24).
# بدون ضبطها تبقى لوحة المطور معطَّلة تمامًا (المسار يُرجع 404).
# DEVELOPER_SECRET=
# اختياري: سر منفصل لتوقيع جلسات المطوّر (الافتراضي مشتق من JWT_ACCESS_SECRET).
# DEVELOPER_JWT_SECRET=

# --- النسخ الاحتياطي وربط Google Drive ---
# مجلد حفظ النسخ المحلية (الافتراضي: مجلد مؤقت). على Vercel القرص مؤقت: استخدم التنزيل اليدوي/Drive.
# BACKUP_DIR=./backups
# مفتاح تشفير أسرار Google في القاعدة (الافتراضي: مشتق من JWT_REFRESH_SECRET).
# BACKUP_ENC_KEY=
# العنوان العام للخادم لبناء redirect URI الخاص بـ OAuth (مثل https://api.example.com). افتراضيًا من رأس الطلب.
# PUBLIC_API_URL=
# يسمح بالنسخ الكامل في نشر فيه أكثر من عميل (يمنحه صاحب الصلاحية بيانات الجميع!) — الافتراضي مرفوض.
# BACKUP_ALLOW_MULTI_TENANT=false
# BACKUP_MAX_UPLOAD_MB=1024

# اختياري — Supabase Storage للمرفقات (بدلها يبقى BYTEA في القاعدة) وتوكن Realtime. أسرار خادم: لا تُوضع في الواجهة.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=attachments
# SUPABASE_JWT_SECRET=   # لتوقيع توكن Realtime القصير (GET /api/realtime/token)

# نطاقات الواجهة المسموحة (CORS) مفصولة بفواصل، مثال: https://app.example.com — إلزامي عمليًا في الإنتاج
CORS_ORIGINS=
