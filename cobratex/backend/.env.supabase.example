# --- add to backend/.env (and to the Vercel backend project env vars) ---------------------------------
# Supabase Postgres. Express connects as the table owner (postgres) => bypasses RLS by design.
#  * Always-on host / local:   SESSION pooler  (port 5432)  or direct connection
#  * Vercel serverless:        TRANSACTION pooler (port 6543)  + DB_POOL_MAX=1
#    (withTransaction BEGIN/COMMIT works in transaction mode; avoid session-level state outside transactions)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_POOL_MAX=1

# Enables verification of Supabase Auth tokens (hybrid phase). Leave unset to keep the old behavior.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# ONLY for legacy projects that still sign tokens with the shared JWT secret (HS256). Leave empty otherwise.
# SUPABASE_JWT_SECRET=

# --- التحكم عن بُعد والأمان (لكل عميل أسراره الخاصة؛ ولّدها بـ: bash tools/new-client.sh) ---
BOOTSTRAP_SECRET=            # إلزامي في الإنتاج (بدونه يصبح /bootstrap غير متاح)
DEVELOPER_SECRET=            # كلمة مرور لوحة المطور (24+ حرفًا)
DEVELOPER_TOTP_SECRET=       # 2FA للوحة المطور: node tools/gen-totp-secret.mjs
# DEVELOPER_IP_ALLOWLIST=1.2.3.4,5.6.7.8   # اختياري: تقييد لوحة المطور بعناوين IP
CRON_SECRET=                 # 16+ حرفًا: يفعّل /api/cron/license-reminders (Vercel Cron يرسله تلقائيًا)
DISABLE_LEGACY_LOGIN=true    # الدخول عبر Supabase Auth فقط
CORS_ORIGINS=                # نطاق الواجهة + نطاق لوحة المطور
# PUSH_VIA_EDGE=true         # عند تفعيل Edge Function send-push
