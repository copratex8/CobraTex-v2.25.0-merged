# ───── عنوان الـ API الخلفي (بلا شرطة مائلة في النهاية) ─────
VITE_API_BASE_URL=http://localhost:4000/api

# ───── وضع المصادقة ─────
# legacy   (الافتراضي): الدخول عبر الخادم نفسه — يعمل مع أي PostgreSQL ومع نسخة سطح المكتب غير المتصلة.
# supabase : الدخول عبر Supabase Auth (يتطلب المفتاحين أدناه + تنفيذ supabase/migrations + تفعيل Custom Access Token Hook).
VITE_AUTH_MODE=legacy

# ───── Supabase (اختياري في وضع legacy: Realtime فقط · إلزامي في وضع supabase) ─────
# مفتاح anon/publishable عام بطبيعته (يظهر في الحزمة) — حمايته سياسات RLS. لا تضع هنا أبدًا service_role.
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# CSP عبر <meta> (ابدأ على staging وراقب الـconsole): on
# VITE_CSP=on
