{
  "name": "backend",
  "version": "2.25.0",
  "description": "CobraTex ERP — REST API (Express + PostgreSQL)",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev -T -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/fix-aliases.js dist",
    "migrate": "ts-node -T -r tsconfig-paths/register -r dotenv/config src/db/migrate.ts",
    "attachments:to-storage": "ts-node -T -r tsconfig-paths/register -r dotenv/config src/scripts/moveAttachmentsToStorage.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.5",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
